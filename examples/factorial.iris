# EXPECTED: factorial(5) == 120
# EXPECTED: factorial(0) == 1
# EXPECTED: factorial(10) == 3628800
# EXPECTED: factorial_iterative(5) == 120
# EXPECTED: factorial_iterative(0) == 1
# EXPECTED: factorial_iterative(10) == 3628800

fn factorial(n: f64) -> f64 {
  if (n <= 1) {
    return 1
  } else {
    return n * factorial(n - 1)
  }
}

fn factorial_iterative(n: f64) -> f64 {
  var result = 1
  var i = 1
  while (i <= n) {
    result = result * i
    i = i + 1
  }
  return result
}
