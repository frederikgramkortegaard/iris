fn simple_phi(x: f64, a: f64, b: f64) -> f64 {
  var result = 0
  if (x > 0) {
    result = a
  } else {
    result = b
  }
  return result
}

fn critical_edge_case(x: f64, y: f64, a: f64, b: f64) -> f64 {
  var result = 0
  if (x > 0) {
    if (y > 0) {
      result = a
    } else {
      result = b
    }
  }
  if (result > 0) {
    result = result + 1
  }
  return result
}

fn loop_with_break(n: f64, threshold: f64) -> f64 {
  var sum = 0
  var i = 0
  while (i < n) {
    sum = sum + i
    if (sum > threshold) {
      return sum
    }
    i = i + 1
  }
  return sum
}

fn nested_loop_exit(n: f64, m: f64) -> f64 {
  var sum = 0
  var i = 0
  while (i < n) {
    var j = 0
    while (j < m) {
      sum = sum + 1
      if (sum > 10) {
        i = n
      }
      j = j + 1
    }
    i = i + 1
  }
  return sum
}

fn swap_in_loop(n: f64, a: f64, b: f64) -> f64 {
  var x = a
  var y = b
  var i = 0
  while (i < n) {
    var tmp = x
    x = y
    y = tmp
    i = i + 1
  }
  return x + y
}
