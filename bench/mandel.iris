# float-heavy: mandelbrot escape iterations summed over a grid
fn cell(cr: f64, ci: f64, maxiter: f64) -> f64 {
  var zr = 0
  var zi = 0
  var i = 0
  while (i < maxiter) {
    var zr2 = zr * zr
    var zi2 = zi * zi
    if (zr2 + zi2 > 4) {
      return i
    }
    zi = 2 * zr * zi + ci
    zr = zr2 - zi2 + cr
    i = i + 1
  }
  return maxiter
}

fn mandel(w: f64, h: f64, maxiter: f64) -> f64 {
  var sum = 0
  var y = 0
  while (y < h) {
    var x = 0
    while (x < w) {
      var cr = x / w * 3.5 - 2.5
      var ci = y / h * 2 - 1
      sum = sum + cell(cr, ci, maxiter)
      x = x + 1
    }
    y = y + 1
  }
  return sum
}
