# branch-heavy: values rotate through both arms of an if inside a loop,
# stresses phi placement and ssa deconstruction copy quality
fn phi(n: f64) -> f64 {
  var a = 1
  var b = 2
  var c = 3
  var i = 0
  while (i < n) {
    if (a < b) {
      var t = a
      a = b
      b = c
      c = t + 1
    } else {
      var t = b
      b = a
      a = c
      c = t - 1
    }
    i = i + 1
  }
  return a + b * 2 + c * 3
}
