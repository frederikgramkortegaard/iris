# loop-heavy: invariant computation inside a hot inner loop, licm bait
fn nested(n: f64, a: f64, b: f64) -> f64 {
  var sum = 0
  var i = 0
  while (i < n) {
    var j = 0
    while (j < 1000) {
      var x = a * b * 1.0001
      sum = sum + x + j
      j = j + 1
    }
    i = i + 1
  }
  return sum
}
